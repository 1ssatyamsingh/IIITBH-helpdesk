APP_NAME=IIITBH RAG API
APP_ENV=development
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
MAX_UPLOAD_FILES=20
MAX_UPLOAD_MB=50
PDF_MIN_TEXT_CHARACTERS_PER_PAGE=30
# Qdrant Cloud: fill after confirming collection and vector configuration.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=document_rag
QDRANT_DISTANCE=Cosine

# Embedding provider: local (llama.cpp) or cloudflare (Workers AI REST API).
# Keep provider/model/dimension identical for ingestion and query embeddings.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL_ID=Qwen/Qwen3-Embedding-0.6B-GGUF:Q8_0
LOCAL_EMBEDDING_BASE_URL=http://127.0.0.1:8088
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_EMBEDDING_MODEL_ID=@cf/qwen/qwen3-embedding-0.6b
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=8
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# Shared Groq credential: used by Qwen VLM for scanned PDF pages.
GROQ_API_KEY=
GROQ_VLM_MODEL=qwen/qwen3.8-27b
GROQ_RENDER_DPI=144
GROQ_MAX_IMAGE_MB=18

# Final answer generation: Groq + OpenAI GPT-OSS 120B.
# The factory reuses GROQ_API_KEY; ANSWER_MODEL_API_KEY is only needed for a separate key.
ANSWER_MODEL_PROVIDER=groq
ANSWER_MODEL_BASE_URL=https://api.groq.com/openai/v1
ANSWER_MODEL_ID=openai/gpt-oss-120b
ANSWER_MODEL_API_KEY=

# Live web search for current institute information (DDGS metasearch).
WEB_SEARCH_ENABLED=true
WEB_SEARCH_MAX_RESULTS=6

# Embedded ingestion worker: runs document processing in a background thread inside FastAPI.
# Recommended for single-instance cloud deployments like Render Web Service (no separate worker process needed).
EMBEDDED_WORKER=false
WORKER_POLL_INTERVAL=2.0

